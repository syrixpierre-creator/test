{
  "name": "inconnu-boy-apk-builder",
  "version": "0.1.0",
  "description": "Open-source platform that turns HTML files, ZIP websites and public URLs into installable Android APKs.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "INCONNU BOY SENSEI",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:browser": "node --test tests/browser/ui.test.js",
    "test:all": "node --test \"tests/*.test.js\" tests/browser/ui.test.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "multer": "2.0.2",
    "pino": "9.6.0",
    "sharp": "0.34.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "playwright": "1.56.0"
  }
}
